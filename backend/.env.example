# ============================================
# Auto Test Platform - 环境变量配置
# 复制此文件为 .env 并修改配置值
# ============================================

# ---- Django 配置 ----
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_SETTINGS_MODULE=core.settings_prod

# CORS 配置（前端域名）
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ---- Redis 配置（用于Channel层和缓存）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- RabbitMQ 配置 ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# RabbitMQ密码加密密钥（生产环境必须设置）
# 使用以下命令生成密钥：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RABBITMQ_ENCRYPTION_KEY=

# ---- 数据库配置 ----
# 支持引擎: sqlite3 (默认), postgresql, mysql
DB_ENGINE=sqlite3
# PostgreSQL 配置 (DB_ENGINE=postgresql 时启用)
# DB_NAME=auto_test_platform
# DB_USER=postgres
# DB_PASSWORD=your-secure-password
# DB_HOST=localhost
# DB_PORT=5432
# MySQL 配置 (DB_ENGINE=mysql 时启用)
# DB_NAME=auto_test_platform
# DB_USER=root
# DB_PASSWORD=your-secure-password
# DB_HOST=localhost
# DB_PORT=3306

# ---- 对象存储配置 (可选) ----
# STORAGE_TYPE=local        # local (默认) 或 minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=auto-test-traces
# MINIO_SECURE=false

# ---- AI 服务配置 (可选) ----
# AI_PRIMARY_PROVIDER=openai
# AI_FALLBACK_PROVIDER=qwen
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# QWEN_API_KEY=sk-xxx
# QWEN_MODEL=qwen-max
# AI_MAX_RETRIES=3
# AI_RETRY_BASE_DELAY=1.0
# AI_TIMEOUT=60
# AI_DEFAULT_MAX_TOKENS=4096

# ---- 测试驱动路径（可选）----
# SELENIUM_DRIVER_PATH=/usr/local/bin/chromedriver
# PLAYWRIGHT_DRIVER_PATH=/usr/local/bin/playwright
